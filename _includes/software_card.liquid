{% comment %}
  Single item rendered once per project by repositories.md.
  Usage: {% include software_card.liquid project=project %}
{% endcomment %}
<style>
  .sw-item {
    display: flex;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--global-divider-color);
    align-items: flex-start;
  }

  .sw-item:last-child {
    border-bottom: none;
  }

  .sw-meta {
    min-width: 90px;
    text-align: right;
    flex-shrink: 0;
  }

  .sw-status,
  .sw-private {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    margin-bottom: 0.3rem;
    white-space: nowrap;
  }

  .sw-status {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #a5d6a7;
  }

  html[data-theme='dark'] .sw-status {
    background: #1b3a1f;
    color: #81c784;
    border-color: #388e3c;
  }

  .sw-status-dev {
    background: #fff8e1;
    color: #e65100;
    border: 1px solid #ffcc80;
  }

  html[data-theme='dark'] .sw-status-dev {
    background: #3a2200;
    color: #ffb74d;
    border-color: #e65100;
  }

  .sw-status-compete {
    background: #e3f2fd;
    color: #1565c0;
    border: 1px solid #90caf9;
  }

  html[data-theme='dark'] .sw-status-compete {
    background: #0d2137;
    color: #64b5f6;
    border-color: #1565c0;
  }

  .sw-private {
    background: #fff8e1;
    color: #f57f17;
    border: 1px solid #ffe082;
  }

  html[data-theme='dark'] .sw-private {
    background: #3a2e00;
    color: #ffd54f;
    border-color: #f9a825;
  }

  .sw-role-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--global-text-color-light);
  }

  .sw-body {
    flex: 1;
    min-width: 0;
  }

  .sw-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--global-text-color);
    margin-bottom: 0.2rem;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sw-title a {
    color: inherit;
    text-decoration: none;
  }

  .sw-title a:hover {
    text-decoration: underline;
  }

  .sw-title .sw-gh-icon {
    color: var(--global-text-color-light);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .sw-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--global-text-color);
    margin: 0 0 0.55rem 0;
  }

  .sw-highlight i {
    color: var(--global-theme-color);
  }

  .sw-company-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.73rem;
    color: var(--global-text-color-light);
    text-decoration: none;
    margin-bottom: 0.45rem;
    font-family: monospace;
  }

  .sw-company-link:hover {
    color: var(--global-text-color);
    text-decoration: underline;
  }

  .sw-desc {
    font-size: 0.85rem;
    color: var(--global-text-color);
    line-height: 1.55;
    margin: 0 0 0.5rem 0;
  }

  .sw-badges {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.1rem;
  }

  .sw-badge {
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.18rem 0.45rem;
    border-radius: 3px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* Featured card: framed panel with a theme-colored accent */
  .sw-item.is-featured {
    border: 1px solid var(--global-divider-color);
    border-left: 3px solid var(--global-theme-color);
    border-radius: 6px;
    padding: 1.2rem 1.4rem;
    margin: 0.4rem 0 1rem 0;
  }

  .sw-item.is-featured:last-child {
    border-bottom: 1px solid var(--global-divider-color);
  }

  /* Logo in place of the text title */
  .sw-title-logo {
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .sw-title-logo picture,
  .sw-title-logo img {
    display: block;
    height: 76px;
    width: auto;
    max-width: 100%;
  }


  /* Animation, floated beside the description on wide screens */
  .sw-media {
    float: right;
    width: 40%;
    max-width: 290px;
    margin: 0.2rem 0 0.6rem 1.3rem;
  }

  .sw-item.is-featured .sw-desc {
    line-height: 1.6;
  }

  .sw-desc code {
    white-space: nowrap;
    font-size: 0.8em;
  }

  .sw-media-frame {
    background: #fff;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    overflow: hidden;
  }

  .sw-media img,
  .sw-media video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Portrait video gets a little more width so its titles stay readable */
  .sw-media.is-video {
    width: 52%;
    max-width: 400px;
  }

  .sw-media figcaption a {
    color: var(--global-theme-color);
    white-space: nowrap;
  }

  .sw-media figcaption {
    font-size: 0.7rem;
    color: var(--global-text-color-light);
    line-height: 1.4;
    margin-top: 0.4rem;
  }

  @media (max-width: 576px) {
    .sw-media,
    .sw-media.is-video {
      float: none;
      width: 100%;
      max-width: none;
      margin: 0 0 0.8rem 0;
    }

    .sw-item.is-featured {
      padding: 1rem;
    }

    .sw-title-logo picture,
    .sw-title-logo img {
      height: 58px;
    }

  }

  .sw-links {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.1rem;
    margin-bottom: 0.45rem;
  }

  .sw-links a {
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.18rem 0.5rem;
    border-radius: 3px;
    border: 1.5px solid var(--global-divider-color);
    color: var(--global-text-color-light);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .sw-links a:hover {
    border-color: var(--global-text-color);
    color: var(--global-text-color);
    text-decoration: none;
  }
</style>

{%- assign sw_status = include.project.status | default: "software" -%}
{%- capture sw_meta -%}
    <span class="sw-status{% if sw_status contains 'development' %} sw-status-dev{% elsif sw_status contains 'compet' %} sw-status-compete{% endif %}">{{ sw_status }}</span>
    {% if include.project.private %}
    <span class="sw-private">private</span>
    {% endif %}
    {% if include.project.role %}
    <span class="sw-role-label">{{ include.project.role }}</span>
    {% endif %}
{%- endcapture -%}
<div class="sw-item{% if include.project.featured %} is-featured{% endif %}">
  <div class="sw-meta">
    {{ sw_meta }}
  </div>

  <div class="sw-body">
    {% if include.project.logo %}
    <div class="sw-title sw-title-logo">
      <a href="{{ include.project.url }}" target="_blank" rel="noopener noreferrer">
        <picture>
          {% if include.project.logo.webp %}<source srcset="{{ include.project.logo.webp | relative_url }}" type="image/webp">{% endif %}
          <img src="{{ include.project.logo.png | relative_url }}" alt="{{ include.project.name }}">
        </picture>
      </a>
      <i class="fab fa-github sw-gh-icon"></i>
    </div>
    {% else %}
    <div class="sw-title">
      {% if include.project.url %}
      <a href="{{ include.project.url }}" target="_blank" rel="noopener noreferrer">{{ include.project.name }}</a>
      <i class="fab fa-github sw-gh-icon"></i>
      {% else %}
      <span>{{ include.project.name }}</span>
      {% endif %}
    </div>
    {% endif %}

    {% if include.project.highlight %}
    <div class="sw-highlight">
      <i class="fas fa-trophy" aria-hidden="true"></i>{{ include.project.highlight }}
    </div>
    {% endif %}

    {% if include.project.company %}
    <a class="sw-company-link" href="{{ include.project.company_url }}" target="_blank" rel="noopener noreferrer">
      <i class="fas fa-building" style="font-size: 0.65rem;"></i>{{ include.project.company }}
    </a>
    {% endif %}

    {% if include.project.media %}
    {%- assign media = include.project.media -%}
    <figure class="sw-media{% if media.mp4 %} is-video{% endif %}">
      <div class="sw-media-frame"{% if media.background %} style="background: {{ media.background }};"{% endif %}>
        {% if media.mp4 %}
        <video autoplay muted loop playsinline preload="auto"
               poster="{{ media.poster | relative_url }}"
               {% if media.width %}width="{{ media.width }}" height="{{ media.height }}"{% endif %}
               aria-label="{{ media.alt }}">
          <source src="{{ media.mp4 | relative_url }}" type="video/mp4">
        </video>
        <script>
          (function () {
            // Respect reduced motion: no autoplay, show a still and let the visitor press play.
            var v = document.currentScript.previousElementSibling;
            if (!v || !window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            v.removeAttribute('autoplay');
            v.pause();
            {% if media.still %}v.poster = '{{ media.still | relative_url }}';{% endif %}
            v.controls = true;
          })();
        </script>
        {% else %}
        <picture>
          {% if media.still %}<source media="(prefers-reduced-motion: reduce)" srcset="{{ media.still | relative_url }}">{% endif %}
          {% if media.webp %}<source srcset="{{ media.webp | relative_url }}" type="image/webp">{% endif %}
          <img src="{{ media.gif | relative_url }}" alt="{{ media.alt }}"{% if media.width %} width="{{ media.width }}" height="{{ media.height }}"{% endif %}>
        </picture>
        {% endif %}
      </div>
      {% if media.caption %}<figcaption>{{ media.caption }}{% if media.mp4 %} <a href="{{ media.mp4 | relative_url }}" target="_blank" rel="noopener noreferrer">Watch full size</a>{% endif %}</figcaption>{% endif %}
    </figure>
    {% endif %}

    <p class="sw-desc">{{ include.project.description }}</p>

    {% if include.project.links %}
    <div class="sw-links">
      {% for link in include.project.links %}
      <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
        {%- if link.icon %}<i class="{{ link.icon }}" style="margin-right: 4px;"></i>{% endif -%}
        {{ link.name }}
      </a>
      {% endfor %}
    </div>
    {% endif %}

    {% if include.project.languages %}
    <div class="sw-badges">
      {% for lang in include.project.languages %}
      <span class="sw-badge" style="background-color: {{ lang.color }}18; color: {{ lang.color }}; border: 1.5px solid {{ lang.color }}55;">
        <i class="{{ lang.icon }}" style="margin-right: 3px;"></i>{{ lang.name }}
      </span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
